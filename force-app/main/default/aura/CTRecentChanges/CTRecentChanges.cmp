<aura:component controller="CTRecentChangesController" implements="flexipage:availableForAllPageTypes">


    <!-- attributes -->
    <aura:attribute name="data" type="Object"/>
    <aura:attribute name="columns" type="List"/>
    <aura:attribute name="issearching" type="Boolean" default="false"/>
    <aura:attribute name="scope" type="string" default="person"/>
    <aura:attribute name="intialResponse" type="List"/>

    <!-- handlers-->
    <aura:handler name="init" value="{! this }" action="{! c.doInit }"/>
    <lightning:card class="slds-var-p-around_medium" title="recentChanges">

    <aura:set attribute="actions">
        <div onkeyup="{!c.handleKeyUp }">
               <lightning:input
            aura:id="enter-search"
            name="search"
            label="Search when user hits the 'enter' key"
            type="search"
            isLoading="{!v.issearching}"
            placeholder="Search Here.."
        /> 
        </div>
    </aura:set>

    
        <lightning:datatable
                keyField="id"
                data="{! v.data }"
                columns="{! v.columns }"
                hideCheckboxColumn="true"
                onrowaction="{! c.handleRowAction }"/>

    </lightning:card>
</aura:component>