<aura:component>
    <aura:handler event="c:CTLocationSelectEvent" action="{!c.CTLocationViewHandler}"/>
    <aura:attribute name="recordId" type="String"/>
    <aura:attribute name="status" type="String"/>
    <aura:attribute name="fields" type="String[]" default="['Name','Pincode__c','Address__c','Status__c','Status_Update_Date__c','Red_Score__c']"/>
    
    <aura:if isTrue="{! !empty(v.recordId)}">
    <div class="{!v.status + ' location-card'}">
        <lightning:recordForm
  recordId="{!v.recordId}"
  objectApiName="Location__c"
  fields="{!v.fields}"
  columns="1"
  mode="readonly"
/>
    </div>
</aura:if>
</aura:component>